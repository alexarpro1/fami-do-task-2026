    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "12.23.26",
    "html5-qrcode": "^2.3.8",
    "input-otp": "1.4.1",
    "jsqr": "1.4.0",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "pako": "2.1.0",
    "peerjs": "1.5.5",
