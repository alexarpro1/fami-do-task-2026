  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/pako": "^2.0.4",
