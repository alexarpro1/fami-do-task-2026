{
  "name": "famiapp",
  "version": "2.6.1",
  "private": true,
  "scripts": {
    "build": "node scripts/increment-version.js && next build",
    "cap:add": "npm install && npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:open": "npx cap open android",
    "android:open": "node scripts/clean-android-builds.js && npx cap open android",
    "cap:sync": "npx cap sync",
    "dev": "node scripts/start-dev-with-yt.mjs",
    "dev:next": "next dev",
    "dev:clean": "node scripts/dev-clean.js",
    "dev:webpack": "next dev --webpack",
    "youtube:server": "node scripts/youtube-download-server.mjs",
    "export": "node scripts/increment-version.js && next build",
    "build:mobile": "next build && npm run cap:icons && npx cap sync",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:sync": "node --test --experimental-strip-types scripts/tests/*.test.mjs && npm run test:sync-security && npm run test:local-sync && npm run test:sync-v3",
    "test:sync-security": "node scripts/test-sync-security.mjs",
    "test:local-sync": "tsx --test lib/local-sync/__tests__/*.test.ts lib/nearby/__tests__/*.test.ts",
    "test:sync-v3": "tsx --test lib/sync-v3/__tests__/*.test.ts",
    "test:nearby": "tsx --test lib/nearby/__tests__/*.test.ts",
    "test:update-security": "tsx --test lib/update-security/__tests__/*.test.ts",
    "verify:update-urls": "node scripts/verify-update-urls.mjs",
    "mobile:build": "npm run export && npm run cap:icons && npx cap sync && npx cap open android",
    "mobile:update": "npm run export && npm run cap:icons && npx cap sync",
    "android:pixel9": "npx cap run android --target=Pixel_9",
    "android:bs": "node scripts/run-android-bs.js",
    "android:list": "npx cap run android --list",
    "android:clean": "node scripts/clean-android-builds.js",
    "android:splash": "node scripts/copy-splash-from-logo.js",
    "cap:icons": "node scripts/cap-update-icons.js",
    "generate:responsive-logo": "node scripts/generate-responsive-logo.js",
    "start": "next start",
    "version:bump": "node scripts/increment-version.js",
    "version:sync": "node scripts/sync-version-public.js",
    "version:backup": "node scripts/version-backup.js",
    "backup:full": "node scripts/full-system-backup.js",
    "version:update": "node scripts/increment-version.js && node scripts/version-backup.js",
    "apk:versioned": "node scripts/copy-apk-versioned.js",
    "apk:keystore": "node scripts/ensure-android-release-keystore.js",
    "apk:release": "node scripts/ensure-android-release-keystore.js && cd android && gradlew.bat assembleRelease && cd .. && node scripts/copy-apk-versioned.js release",
    "apk:sync-drive": "node scripts/sync-apk-to-drive.js",
    "apk:build": "npm run version:update && npm run build:mobile && npm run apk:keystore && cd android && gradlew.bat assembleRelease && cd .. && node scripts/copy-apk-versioned.js release && npm run apk:sync-drive",
    "wlan:servers": "node scripts/start-wlan-servers.js"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
